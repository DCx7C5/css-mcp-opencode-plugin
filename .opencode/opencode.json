{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "github:DCx7C5/css-mcp-opencode-plugin"
  ],
  "model": "opencode/deepseek-v4.1-flash-free#max",
  "snapshots": false,
  "shell": "fish",
  "formatter": true,
  "default_agent": "css-planner",
  "experimental": {
    "subagent_depth": 2,
    "background_compaction": false,
    "schedules": true,
    "image_generate": true
  },
  "compaction": {
    "auto": false,
    "keep": { "tokens": 8000 }
  },
  "providers": {
    "local": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "moondream:latest-gpuonly": {
          "name": "Moondream (vision, GPU)",
          "capabilities": { "tools": false, "input": ["text", "image"], "output": ["text"] }
        },
        "qwen3-embedding:0.6b": {
          "name": "Qwen3 Embedding 0.6B",
          "disabled": true,
          "capabilities": { "tools": false, "input": ["text"], "output": ["text"] }
        },
        "phi4-mini:latest": {
          "name": "Phi-4 Mini",
          "disabled": true,
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "gemma3:1b-cpuonly": {
          "name": "Gemma 3 1B (CPU)",
          "capabilities": { "tools": false, "input": ["text", "image"], "output": ["text"] }
        },
        "gemma3:1b-gpuonly": {
          "name": "Gemma 3 1B (GPU)",
          "capabilities": { "tools": false, "input": ["text", "image"], "output": ["text"] }
        },
        "qwen3:0.6b-gpuonly": {
          "name": "Qwen3 0.6B (GPU)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 16384, "output": 1024 },
          "body": { "think": false }
        },
        "qwen3:0.6b-cpuonly": {
          "name": "Qwen3 0.6B (CPU)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 16384, "output": 1024 },
          "body": { "think": false }
        },
        "qwen2.5-coder:3b": {
          "name": "Qwen2.5 Coder 3B",
          "capabilities": { "tools": false, "input": ["text"], "output": ["text"] }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "css": {
        "type": "remote",
        "url": "http://127.0.0.1:8000/mcp",
        "disabled": false
      }
    }
  },
  "agents": {
    "css-planner": {
      "mode": "primary",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "css*", "effect": "allow" },
        { "action": "subagent", "resource": "css-factory", "effect": "ask" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "uv run ruff check --fix*", "effect": "allow" },
        { "action": "shell", "resource": "uv run ruff check --diff*", "effect": "allow" },
        { "action": "shell", "resource": "*sqlite3*", "effect": "allow" },
        { "action": "shell", "resource": "uv add *", "effect": "allow" },
        { "action": "shell", "resource": "uv sync*", "effect": "allow" },
        { "action": "shell", "resource": "uv run pytest*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "css*", "resource": "*", "effect": "ask" },
        { "action": "css*ide_*", "resource": "*", "effect": "allow" },
        { "action": "css*ide_apply_patch", "resource": "*", "effect": "deny" },
        { "action": "css*ide_execute_terminal_command", "resource": "*", "effect": "ask" },
        { "action": "css*git_*", "resource": "*", "effect": "allow" },
        { "action": "css*todo_*", "resource": "*", "effect": "allow" },
        { "action": "css*sqlite_query", "resource": "*", "effect": "allow" },
        { "action": "css*session_quicksearch", "resource": "*", "effect": "allow" },
        { "action": "css*history_lookup", "resource": "*", "effect": "allow" },
